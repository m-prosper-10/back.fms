{
  "name": "fms_backend",
  "version": "1.0.0",
  "description": "Production baseline microservices monorepo for a general business API",
  "private": true,
  "main": "dist/services/api-gateway/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev-all.js",
    "dev:all": "node scripts/dev-all.js",
    "dev:api-gateway": "TS_NODE_FILES=true ts-node services/api-gateway/src/server.ts",
    "dev:auth-service": "TS_NODE_FILES=true ts-node services/auth-service/src/server.ts",
    "dev:user-service": "TS_NODE_FILES=true ts-node services/user-service/src/server.ts",
    "dev:extinguisher-service": "TS_NODE_FILES=true ts-node services/extinguisher-service/src/server.ts",
    "dev:inspection-service": "TS_NODE_FILES=true ts-node services/inspection-service/src/server.ts",
    "dev:reporting-service": "TS_NODE_FILES=true ts-node services/reporting-service/src/server.ts",
    "dev:notification-service": "TS_NODE_FILES=true ts-node services/notification-service/src/server.ts",
    "seed:users": "TS_NODE_FILES=true ts-node scripts/seed-users.ts",
    "start": "node dist/services/api-gateway/src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "backend",
    "express",
    "typescript",
    "rest",
    "microservices",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.15",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
