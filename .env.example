NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
MONGODB_URL=mongodb://localhost:27017/fms_backend
REDIS_URL=redis://localhost:6379

# auth-service secrets
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
PASSWORD_RESET_TOKEN_SECRET=change-me-reset
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# Service defaults
# api-gateway: PORT=4000 APP_NAME=api-gateway
# auth-service: PORT=4001 APP_NAME=auth-service
# user-service: PORT=4002 APP_NAME=user-service
# extinguisher-service: PORT=4003 APP_NAME=extinguisher-service
# inspection-service: PORT=4004 APP_NAME=inspection-service
# reporting-service: PORT=4005 APP_NAME=reporting-service (requires MONGODB_URL + JWT_ACCESS_SECRET)
# notification-service: PORT=4006 APP_NAME=notification-service (requires MONGODB_URL + JWT_ACCESS_SECRET)
